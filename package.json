{
	"name": "remco-consul-worker",
	"private": true,
	"version": "0.2.3",
	"workspaces": [
		"packages/consul",
		"packages/consul-worker",
		"packages/consul-worker-all",
		"packages/consul-worker-db",
		"packages/consul-worker-secret"
	],
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"cf-typegen": "npm run cf-typegen --workspaces --if-present",
		"coverage": "npm run coverage --workspaces --if-present",
		"dev": "npm run build && npm run dev --workspaces --if-present",
		"lint": "npm run lint --workspaces --if-present",
		"release": "npm run release --workspaces --if-present && release-it",
		"release:ci": "npm run release:ci:patch",
		"release:ci:major": "npm run release:ci:major --workspaces --if-present && release-it major --ci",
		"release:ci:minor": "npm run release:ci:minor --workspaces --if-present && release-it minor --ci",
		"release:ci:patch": "npm run release:ci:patch --workspaces --if-present && release-it patch --ci",
		"release:dryrun": "npm run release:dryrun --workspaces --if-present && release-it --dry-run",
		"test": "npm run test --workspaces --if-present",
		"test:workers": "npm run test:workers --workspaces --if-present"
	},
	"devDependencies": {
		"@release-it/bumper": "^7.0.6",
		"auto-changelog": "^2.5.1",
		"release-it": "^21.0.0"
	},
	"release-it": {
		"git": {
			"requiredBranch": "main",
			"commitMessage": "chore(release): v${version}",
			"tagName": "v${version}",
			"requireCleanWorkingDir": false
		},
		"github": {
			"autoGenerate": true,
			"release": true,
			"releaseName": "v${version}"
		},
		"hooks": {
			"after:bump": "npx auto-changelog -p"
		}
	},
	"npm": {
		"publish": false
	}
}
