{
	"name": "@andrewheberle/remco-kv-json-rpc",
	"version": "0.0.0",
	"description": "A JSON-RPC server for Cloudflare Workers KV used by remco-websocket",
	"type": "module",
    "main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
            "import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"coverage": "vitest run --coverage",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build",
		"release": "release-it",
		"release:ci": "release-it --ci",
		"release:dryrun": "release-it --dry-run"
	},
	"dependencies": {
		"@andrewheberle/ts-slog": "^1.3.0",
		"@cloudflare/workers-types": "^4.20260528.1",
		"hono": "^4.10.6",
        "typed-rpc": "^6.1.2"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^4.1.7",
		"tsx": "^4.21.0",
		"typescript": "^6.0.0",
		"vitest": "^4.1.7"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/andrewheberle/remco-websocket.git"
	},
	"homepage": "https://github.com/andrewheberle/remco-websocket#readme",
	"bugs": {
		"url": "https://github.com/andrewheberle/remco-websocket/issues"
	},
	"author": "Andrew Heberle",
	"license": "Apache-2.0",
	"release-it": {
		"git": false,
		"npm": {
			"publish": true,
			"skipChecks": true
		}
	}
}